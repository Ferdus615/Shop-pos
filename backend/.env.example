# Application
NODE_ENV=development

# Schema changes come from migrations (npm run migration:run), never from the
# entities. Set this to true ONLY against a throwaway database, where letting
# TypeORM reshape the schema on boot is a convenience rather than a risk.
# DB_SYNCHRONIZE=false
PORT=5000
# Business timezone for sales/expense report boundaries (server may run in UTC)
APP_TIMEZONE=Asia/Dhaka

# Database — Neon (paste your connection string from the Neon dashboard)
# Go to: Neon Dashboard → your project → Connection Details → copy the connection string
DATABASE_URL=postgresql://neondb_owner:your-password@ep-xxxxx-xxxxx-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Comma-separated list of origins allowed to call this API. REQUIRED when
# NODE_ENV=production — the app refuses to start without it, rather than coming
# up healthy and rejecting every browser. Outside production the fallback is
# localhost. One hostname label may be a "*" wildcard, for preview
# deployments; keep a project-specific prefix in it, since a bare
# "https://*.vercel.app" would admit every site on that platform.
# CORS_ORIGINS=https://pos.example.com,https://pos-*.vercel.app

# JWT auth
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Platform administrator — creates and suspends shops, sees no shop's data.
# Belongs to no shop. Created on startup if the email is not already taken.
SUPER_ADMIN_NAME=Platform Admin
SUPER_ADMIN_EMAIL=admin@shop-pos.local
SUPER_ADMIN_PASSWORD=admin123

# Demo shop seeded on first run, plus its owner account.
SEED_SHOP_NAME=Demo Shop
SEED_SHOP_SLUG=demo-shop
SEED_SHOP_ADDRESS=Sector-7, Road-5, Uttara, Dhaka
SEED_SHOP_PHONE=
OWNER_NAME=Shop Owner
OWNER_EMAIL=owner@shop.local
OWNER_PASSWORD=owner123
