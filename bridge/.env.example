# --- Where the POS backend lives -------------------------------------------
API_URL=http://localhost:5000

# Credentials for a dedicated shop user the bridge signs in as.
# Create this account under Staff in the POS; it needs no special role, but it
# must belong to the shop whose printer this PC is attached to.
BRIDGE_EMAIL=printer@shop.local
BRIDGE_PASSWORD=change-me

# --- Printer ----------------------------------------------------------------
# Windows: the OUTGOING COM port Windows created when you paired the BT583.
#   Settings > Bluetooth & devices > Devices > More Bluetooth settings > COM Ports
# Linux:   /dev/rfcomm0 after `rfcomm bind 0 <MAC> 1`
# Run `npm run probe` to list the ports this machine can see.
PRINTER_PORT=COM3
PRINTER_BAUD=9600

# Characters per line: 32 for a 58mm printer (the BT583), 48 for 80mm.
PRINTER_COLUMNS=32

# Does the printer have a paper cutter? Most 58mm pocket printers do not.
PRINTER_HAS_CUTTER=false

# Blank lines fed after each slip so it clears the tear bar.
PRINTER_FEED_LINES=4

# --- Behaviour --------------------------------------------------------------
# How often to ask the backend for new slips, in milliseconds.
POLL_INTERVAL_MS=1500

# Label shown in the POS when staff check whether the printer is online.
STATION_NAME=Counter PC

# Local fast path: Windows tills on this same machine can POST straight here
# instead of round-tripping through the backend. Set to 0 to disable.
LOCAL_PORT=9110
